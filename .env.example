# Copier ce fichier en .env et l'adapter. Le fichier .env n'est jamais versionné.
# Les valeurs ci-dessous fonctionnent avec `pnpm db:up` (docker-compose.yml).

# ─── API ─────────────────────────────────────────
# Port de l'API.
API_PORT=3001
# Connexion à PostgreSQL.
DATABASE_URL=postgresql://gofac:gofac@localhost:5432/gofac
# Secret de signature des sessions. En production : une longue valeur aléatoire (openssl rand -hex 32).
SESSION_SECRET=change-me-in-production
# Adresse du site web (autorisée à appeler l'API).
WEB_URL=http://localhost:3000

# ─── Site web ────────────────────────────────────
# Adresse de l'API vue depuis le navigateur.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── E-mails ─────────────────────────────────────
# En développement, Mailpit capte tous les e-mails : http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@association.test

# ─── Paiements (Stripe en mode TEST uniquement) ──
# Clés de test du tableau de bord Stripe (commencent par sk_test_ / pk_test_ / whsec_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
